{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsgxp",
  "main": "worker.ts",
  "compatibility_date": "2026-09-07",
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    // 01:00 UTC = 8:00 PM EST (9:00 PM EDT during Daylight Saving Time)
    "crons": ["0 1 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsgxp-db",
      "database_id": "0248d9ad-d24e-4436-a6a9-7c8169309b91",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "RETENTION_DAYS": "45",
    "MAX_AI_ENRICH_PER_RUN": "40",
    "MAX_AI_JOBS_ENRICH_PER_RUN": "40"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
